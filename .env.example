# GitLens Pro Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

# GitHub OAuth App (GITLENS_ prefix required)
GITLENS_GITHUB_CLIENT_ID=your_github_client_id
GITLENS_GITHUB_CLIENT_SECRET=your_github_client_secret

# Encryption key for GitHub tokens (32-char hex string)
# Generate with: openssl rand -hex 32
GITLENS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
GITLENS_DATABASE_HOST=mysql
GITLENS_DATABASE_PORT=3306
GITLENS_DATABASE_USER=gitlens
GITLENS_DATABASE_PASSWORD=gitlens_secret
GITLENS_DATABASE_NAME=gitlens

# Server
GITLENS_SERVER_BASE_URL=http://localhost:8080

# Email (defaults point to MailHog)
GITLENS_EMAIL_SMTP_HOST=mailhog
GITLENS_EMAIL_SMTP_PORT=1025
