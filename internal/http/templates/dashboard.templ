package templates

templ DashboardPage(data PageData) {
	@Layout(data) {
		@DashboardContent(data)
	}
}

templ DashboardContent(data PageData) {
	<div class="space-y-8">
		<!-- Welcome -->
		<div>
			if data.User != nil {
				<h2 class="text-2xl font-bold tracking-tight">
					Welcome back, { data.User.Username }
				</h2>
			} else {
				<h2 class="text-2xl font-bold tracking-tight">Dashboard</h2>
			}
			<p class="mt-1 text-gray-500 dark:text-gray-400">Here's what's happening across your repositories.</p>
		</div>
		<!-- Quick actions -->
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			@quickAction("/repos", "Add Repository", "Import a GitHub repository to analyze.", iconPlusRepo())
			@quickAction("/reviews", "Start Review", "Create a new code review or audit.", iconPlusReview())
			@quickAction("/notifications", "Notifications", "Check your latest updates.", iconBellAction())
			@quickAction("/settings", "Settings", "Manage your preferences.", iconCogAction())
		</div>
		<!-- Getting started -->
		@Card("Getting Started") {
			<div class="space-y-4">
				@stepItem("1", "Add a repository", "Import a GitHub repository to start analyzing commits, contributors, and forks.", "/repos", false)
				@stepItem("2", "Explore commits", "Browse the commit history, view diffs with syntax highlighting, and run blame.", "", true)
				@stepItem("3", "Analyze forks", "Discover forks, classify changes, detect cherry-picks and rebases.", "", true)
				@stepItem("4", "Review code", "Create code reviews with inline comments, participant tracking, and decisions.", "", true)
			</div>
		}
	</div>
}

templ quickAction(href, title, description string, icon templ.Component) {
	<a
		href={ templ.SafeURL(href) }
		class="group rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 hover:shadow-md transition-all"
	>
		<div class="flex items-start gap-4">
			<div class="rounded-lg bg-indigo-50 dark:bg-indigo-950/50 p-2.5 text-indigo-600 dark:text-indigo-400 group-hover:bg-indigo-100 dark:group-hover:bg-indigo-950 transition-colors">
				@icon
			</div>
			<div>
				<h3 class="text-sm font-semibold">{ title }</h3>
				<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{ description }</p>
			</div>
		</div>
	</a>
}

templ stepItem(number, title, description, href string, disabled bool) {
	<div class={ "flex items-start gap-4 p-4 rounded-lg", templ.KV("opacity-50", disabled) }>
		<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-950/50 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
			{ number }
		</div>
		<div class="flex-1">
			<h4 class="text-sm font-medium">{ title }</h4>
			<p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">{ description }</p>
		</div>
		if href != "" && !disabled {
			<a
				href={ templ.SafeURL(href) }
				class="shrink-0 rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-indigo-500 transition-colors"
			>
				Get started
			</a>
		}
	</div>
}

templ iconPlusRepo() {
	<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 10.5v6m3-3H9m4.06-7.19-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"></path>
	</svg>
}

templ iconPlusReview() {
	<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
	</svg>
}

templ iconBellAction() {
	<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"></path>
	</svg>
}

templ iconCogAction() {
	<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"></path>
		<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
	</svg>
}
