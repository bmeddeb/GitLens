package analysistemplates

import (
	"fmt"
	"github.com/user/gitlens-pro/internal/http/templates"
	"github.com/user/gitlens-pro/internal/repository"
)

templ ForkListPage(pd templates.PageData, repoID uint64, repo *repository.Repository, forks []repository.Fork, nextCursor string) {
	@templates.Layout(pd) {
		@ForkListContent(repoID, repo, forks, nextCursor)
	}
}

templ ForkListContent(repoID uint64, repo *repository.Repository, forks []repository.Fork, nextCursor string) {
	<div class="space-y-6">
		<!-- Breadcrumb -->
		<div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
			<a href="/repos" class="hover:text-gray-700 dark:hover:text-gray-300">Repositories</a>
			<span>/</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/repos/%d", repoID)) } class="hover:text-gray-700 dark:hover:text-gray-300">{ repo.FullName }</a>
			<span>/</span>
			<span class="text-gray-900 dark:text-gray-100">Forks</span>
		</div>
		<div class="flex items-start justify-between">
			<div>
				<h2 class="text-2xl font-bold tracking-tight">Forks</h2>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Known forks of { repo.FullName }.</p>
			</div>
			<a
				href={ templ.SafeURL(fmt.Sprintf("/repos/%d/fork-report", repoID)) }
				class="inline-flex items-center gap-2 rounded-lg bg-white dark:bg-gray-800 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
			>
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"></path>
				</svg>
				Fork Report
			</a>
		</div>
		if len(forks) == 0 {
			@templates.EmptyState("No forks found", "Forks are discovered when the repository is synced from GitHub.")
		} else {
			<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm overflow-hidden">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-gray-100 dark:border-gray-800 text-left text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">
							<th class="px-5 py-3">Fork</th>
							<th class="px-5 py-3">Status</th>
							<th class="px-5 py-3 text-right">Ahead</th>
							<th class="px-5 py-3 text-right">Behind</th>
							<th class="px-5 py-3">Last Analyzed</th>
							<th class="px-5 py-3"></th>
						</tr>
					</thead>
					<tbody id="fork-table-body" class="divide-y divide-gray-100 dark:divide-gray-800">
						for _, f := range forks {
							@ForkRow(repoID, f)
						}
					</tbody>
				</table>
			</div>
			if nextCursor != "" {
				@templates.LoadMore(fmt.Sprintf("/fragments/forks/%d?cursor=%s", repoID, nextCursor))
			}
		}
	</div>
}

templ ForkRows(repoID uint64, forks []repository.Fork, nextCursor string) {
	for _, f := range forks {
		@ForkRow(repoID, f)
	}
	if nextCursor != "" {
		@templates.LoadMore(fmt.Sprintf("/fragments/forks/%d?cursor=%s", repoID, nextCursor))
	}
}

templ ForkRow(repoID uint64, f repository.Fork) {
	<tr
		id={ fmt.Sprintf("fork-%d", f.ID) }
		if f.AnalysisStatus == "analyzing" || f.AnalysisStatus == "pending" {
			hx-get={ fmt.Sprintf("/fragments/fork-row/%d/%d", repoID, f.ID) }
			hx-trigger="every 3s"
			hx-swap="outerHTML"
		}
	>
		<td class="px-5 py-3">
			<div>
				<p class="font-medium">{ f.ForkFullName }</p>
				<p class="text-xs text-gray-400 dark:text-gray-500">{ f.ForkOwner }</p>
			</div>
		</td>
		<td class="px-5 py-3">
			@ForkStatusBadge(f.AnalysisStatus)
		</td>
		<td class="px-5 py-3 text-right tabular-nums">
			if f.AheadBy > 0 {
				<span class="text-emerald-600 dark:text-emerald-400 font-medium">{ fmt.Sprintf("+%d", f.AheadBy) }</span>
			} else {
				<span class="text-gray-400">0</span>
			}
		</td>
		<td class="px-5 py-3 text-right tabular-nums">
			if f.BehindBy > 0 {
				<span class="text-red-500 dark:text-red-400 font-medium">{ fmt.Sprintf("-%d", f.BehindBy) }</span>
			} else {
				<span class="text-gray-400">0</span>
			}
		</td>
		<td class="px-5 py-3 text-xs text-gray-500 dark:text-gray-400">
			if f.LastAnalyzedAt != nil {
				{ f.LastAnalyzedAt.Format("Jan 2, 2006 15:04") }
			} else {
				<span class="text-gray-400">Never</span>
			}
		</td>
		<td class="px-5 py-3 text-right">
			<div class="flex items-center justify-end gap-2">
				if f.AnalysisStatus == "complete" {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/repos/%d/forks/%d/changes", repoID, f.ID)) }
						class="text-xs text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-medium"
					>
						Changes
					</a>
				}
				if f.AnalysisStatus != "analyzing" && f.AnalysisStatus != "pending" {
					<button
						hx-post={ fmt.Sprintf("/api/repos/%d/forks/%d/analyze", repoID, f.ID) }
						hx-target={ fmt.Sprintf("#fork-%d", f.ID) }
						hx-swap="outerHTML"
						class="text-xs text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 font-medium"
					>
						Analyze
					</button>
				}
			</div>
		</td>
	</tr>
}

templ ForkStatusBadge(status string) {
	switch status {
		case "complete":
			@templates.Badge("Complete", "green")
		case "analyzing":
			<span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-400 ring-1 ring-inset ring-blue-600/20">
				<svg class="h-3 w-3 animate-spin" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
				</svg>
				Analyzing
			</span>
		case "pending":
			@templates.Badge("Pending", "yellow")
		case "error":
			@templates.Badge("Error", "red")
		default:
			@templates.Badge("Listed", "")
	}
}
