package analysistemplates

import (
	"fmt"
	"github.com/user/gitlens-pro/internal/gitclient"
	"github.com/user/gitlens-pro/internal/http/templates"
	"github.com/user/gitlens-pro/internal/http/templates/diff"
	"github.com/user/gitlens-pro/internal/repository"
)

templ CommitDetailPage(pd templates.PageData, repoID uint64, repo *repository.Repository, commit *repository.Commit, diffResult *gitclient.DiffResult, view string) {
	@templates.Layout(pd) {
		@CommitDetailContent(repoID, repo, commit, diffResult, view)
	}
}

templ CommitDetailContent(repoID uint64, repo *repository.Repository, commit *repository.Commit, diffResult *gitclient.DiffResult, view string) {
	<div class="space-y-6">
		<!-- Breadcrumb -->
		<div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
			<a href="/repos" class="hover:text-gray-700 dark:hover:text-gray-300">Repositories</a>
			<span>/</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/repos/%d", repoID)) } class="hover:text-gray-700 dark:hover:text-gray-300">{ repo.FullName }</a>
			<span>/</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/repos/%d/commits", repoID)) } class="hover:text-gray-700 dark:hover:text-gray-300">Commits</a>
			<span>/</span>
			<span class="text-gray-900 dark:text-gray-100 font-mono text-xs">{ shortSHA(commit.SHA) }</span>
		</div>
		<!-- Commit info -->
		<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm p-6">
			<h2 class="text-xl font-bold tracking-tight">{ commitMessage(*commit) }</h2>
			if commit.Message != nil && hasMultiline(*commit.Message) {
				<pre class="mt-3 text-sm text-gray-600 dark:text-gray-400 whitespace-pre-wrap font-sans">{ commitBody(*commit.Message) }</pre>
			}
			<div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
				<div class="flex items-center gap-1.5">
					<div class="h-5 w-5 rounded-full bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center text-xs font-bold text-indigo-700 dark:text-indigo-400">
						{ initial(derefStr(commit.AuthorName, "?")) }
					</div>
					<span class="font-medium text-gray-700 dark:text-gray-300">{ derefStr(commit.AuthorName, "Unknown") }</span>
					if commit.AuthorEmail != nil {
						<span class="text-gray-400">&lt;{ *commit.AuthorEmail }&gt;</span>
					}
				</div>
				<span>{ commit.CommittedAt.Format("Jan 2, 2006 at 15:04") }</span>
				<code class="font-mono text-xs bg-gray-100 dark:bg-gray-800 rounded px-2 py-0.5">{ commit.SHA }</code>
			</div>
			if len(commit.ParentSHAs) > 0 {
				<div class="mt-2 flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
					<span>Parents:</span>
					for _, p := range commit.ParentSHAs {
						<a href={ templ.SafeURL(fmt.Sprintf("/repos/%d/commits/%s", repoID, p)) } class="font-mono hover:text-indigo-500">{ shortSHA(p) }</a>
					}
				</div>
			}
			<!-- Stats -->
			<div class="mt-4 flex items-center gap-4 text-sm">
				if commit.FilesChanged != nil {
					<span class="text-gray-500 dark:text-gray-400">{ fmt.Sprintf("%d files changed", *commit.FilesChanged) }</span>
				}
				if commit.Insertions != nil && *commit.Insertions > 0 {
					<span class="text-emerald-600 dark:text-emerald-400 font-medium">{ fmt.Sprintf("+%d insertions", *commit.Insertions) }</span>
				}
				if commit.Deletions != nil && *commit.Deletions > 0 {
					<span class="text-red-500 dark:text-red-400 font-medium">{ fmt.Sprintf("-%d deletions", *commit.Deletions) }</span>
				}
			</div>
		</div>
		<!-- Diff -->
		<div id="diff-container">
			@diff.DiffView(diffResult, view)
		</div>
	</div>
}

// DiffFragment renders just the diff portion for HTMX swaps (view toggle).
templ DiffFragment(diffResult *gitclient.DiffResult, view string) {
	@diff.DiffView(diffResult, view)
}

func hasMultiline(msg string) bool {
	for i, ch := range msg {
		if ch == '\n' && i < len(msg)-1 {
			return true
		}
	}
	return false
}

func commitBody(msg string) string {
	for i, ch := range msg {
		if ch == '\n' {
			body := msg[i+1:]
			// Trim leading newlines
			for len(body) > 0 && body[0] == '\n' {
				body = body[1:]
			}
			return body
		}
	}
	return ""
}

func initial(name string) string {
	if len(name) == 0 {
		return "?"
	}
	// Return first character uppercased
	for _, r := range name {
		if r >= 'a' && r <= 'z' {
			return string(r - 32)
		}
		return string(r)
	}
	return "?"
}
