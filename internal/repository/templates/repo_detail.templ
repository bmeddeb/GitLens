package repotemplates

import (
	"fmt"
	"github.com/user/gitlens-pro/internal/http/templates"
	"github.com/user/gitlens-pro/internal/repository"
)

templ RepoDetailPage(pd templates.PageData, repo *repository.Repository, ur *repository.UserRepository) {
	@templates.Layout(pd) {
		@RepoDetailContent(pd, repo, ur)
	}
}

templ RepoDetailContent(pd templates.PageData, repo *repository.Repository, ur *repository.UserRepository) {
	<div class="space-y-6">
		<!-- Header -->
		<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
			<div>
				<div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
					<a href="/repos" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Repositories</a>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
					</svg>
					<span>{ repo.Owner }</span>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
					</svg>
				</div>
				<h2 class="mt-1 text-2xl font-bold tracking-tight">{ repo.Name }</h2>
				if repo.Description != nil && *repo.Description != "" {
					<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{ *repo.Description }</p>
				}
				<div class="mt-3 flex items-center gap-3">
					@RepoCloneStatusBadge(repo.CloneStatus)
					if repo.IsPrivate {
						@templates.Badge("Private", "")
					} else {
						@templates.Badge("Public", "")
					}
					if repo.IsFork {
						@templates.Badge("Fork", "purple")
					}
					if ur != nil && ur.AccessState == "suspended" {
						@templates.Badge("Access Suspended", "red")
					}
				</div>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				if repo.CloneStatus == "ready" {
					<button
						hx-post={ fmt.Sprintf("/api/repos/%d/sync", repo.ID) }
						hx-swap="none"
						class="inline-flex items-center gap-2 rounded-lg bg-white dark:bg-gray-800 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
					>
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182"></path>
						</svg>
						Sync
					</button>
				}
				<button
					hx-post={ fmt.Sprintf("/api/repos/%d/recheck-access", repo.ID) }
					hx-swap="none"
					class="inline-flex items-center gap-2 rounded-lg bg-white dark:bg-gray-800 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
				>
					Recheck access
				</button>
				<button
					hx-delete={ fmt.Sprintf("/api/repos/%d", repo.ID) }
					hx-confirm="Remove this repository from your workspace? The clone data will be preserved for other users."
					hx-swap="none"
					class="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-red-600 dark:text-red-400 ring-1 ring-inset ring-red-200 dark:ring-red-800 hover:bg-red-50 dark:hover:bg-red-950/50 transition-colors"
					onclick="setTimeout(function(){ window.location.href='/repos'; }, 300)"
				>
					Remove
				</button>
			</div>
		</div>
		<!-- Info cards -->
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			@templates.StatCard("Default Branch", repo.DefaultBranch, "")
			@templates.StatCard("Clone Status", repo.CloneStatus, "")
			if repo.LastSyncedAt != nil {
				@templates.StatCard("Last Synced", repo.LastSyncedAt.Format("Jan 2, 2006 15:04"), "")
			} else {
				@templates.StatCard("Last Synced", "Never", "")
			}
			@templates.StatCard("Created", repo.CreatedAt.Format("Jan 2, 2006"), "")
		</div>
		<!-- Navigation tabs -->
		if repo.CloneStatus == "ready" {
			@repoTabs(repo.ID)
		} else {
			@templates.Card("") {
				<div class="text-center py-8">
					if repo.CloneStatus == "cloning" || repo.CloneStatus == "pending" {
						@templates.Spinner()
						<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Repository is being cloned. Analysis features will be available once the clone completes.</p>
					} else {
						<p class="text-sm text-gray-500 dark:text-gray-400">Repository clone failed. Try syncing again or check the job logs.</p>
					}
				</div>
			}
		}
	</div>
}

templ repoTabs(repoID uint64) {
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		@repoTabCard(fmt.Sprintf("/repos/%d/commits", repoID), "Commits", "Browse commit history and view diffs.", iconCommits())
		@repoTabCard(fmt.Sprintf("/repos/%d/contributors", repoID), "Contributors", "View contributor stats and activity.", iconContributors())
		@repoTabCard(fmt.Sprintf("/repos/%d/forks", repoID), "Forks", "Analyze forks, detect cherry-picks and rebases.", iconForks())
		@repoTabCard(fmt.Sprintf("/repos/%d/reviews", repoID), "Reviews", "Code reviews and audits for this repository.", iconReviews())
	</div>
}

templ repoTabCard(href string, title string, description string, icon templ.Component) {
	<a
		href={ templ.SafeURL(href) }
		class="group rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 hover:shadow-md transition-all"
	>
		<div class="flex items-start gap-3">
			<div class="rounded-lg bg-gray-100 dark:bg-gray-800 p-2 text-gray-500 dark:text-gray-400 group-hover:bg-indigo-50 dark:group-hover:bg-indigo-950/50 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
				@icon
			</div>
			<div>
				<h3 class="text-sm font-semibold group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{ title }</h3>
				<p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">{ description }</p>
			</div>
		</div>
	</a>
}

templ iconCommits() {
	<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
	</svg>
}

templ iconContributors() {
	<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"></path>
	</svg>
}

templ iconForks() {
	<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"></path>
	</svg>
}

templ iconReviews() {
	<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"></path>
	</svg>
}
