package repotemplates

import (
	"fmt"
	"github.com/user/gitlens-pro/internal/http/templates"
	"github.com/user/gitlens-pro/internal/repository"
)

templ RepoListPage(pd templates.PageData, repos []repository.UserRepository, nextCursor string) {
	@templates.Layout(pd) {
		@RepoListContent(repos, nextCursor)
	}
}

templ RepoListContent(repos []repository.UserRepository, nextCursor string) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<div>
				<h2 class="text-2xl font-bold tracking-tight">Repositories</h2>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage your imported GitHub repositories.</p>
			</div>
			<button
				hx-get="/fragments/repo-add-form"
				hx-target="#modal"
				hx-swap="innerHTML"
				class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 transition-colors"
			>
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
				</svg>
				Add repository
			</button>
		</div>
		<div id="repo-list">
			if len(repos) == 0 {
				@templates.EmptyState("No repositories yet", "Import a GitHub repository to get started with commit analysis, blame, and code review.")
			} else {
				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					for _, ur := range repos {
						@RepoCard(ur)
					}
				</div>
				if nextCursor != "" {
					@templates.LoadMore(fmt.Sprintf("/fragments/repo-cards?cursor=%s", nextCursor))
				}
			}
		</div>
	</div>
}

templ RepoCards(repos []repository.UserRepository, nextCursor string) {
	for _, ur := range repos {
		@RepoCard(ur)
	}
	if nextCursor != "" {
		@templates.LoadMore(fmt.Sprintf("/fragments/repo-cards?cursor=%s", nextCursor))
	}
}

templ RepoCard(ur repository.UserRepository) {
	if ur.Repository != nil {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/repos/%d", ur.RepoID)) }
			class="group flex flex-col rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow-sm hover:border-indigo-300 dark:hover:border-indigo-700 hover:shadow-md transition-all"
		>
			<div class="p-5 flex-1">
				<div class="flex items-start justify-between gap-2">
					<div class="min-w-0 flex-1">
						<div class="flex items-center gap-2">
							<span class="text-xs text-gray-400 dark:text-gray-500 truncate">{ ur.Repository.Owner }/</span>
						</div>
						<h3 class="text-sm font-semibold truncate group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
							{ ur.Repository.Name }
						</h3>
					</div>
					@RepoCloneStatusBadge(ur.Repository.CloneStatus)
				</div>
				if ur.Repository.Description != nil && *ur.Repository.Description != "" {
					<p class="mt-2 text-xs text-gray-500 dark:text-gray-400 line-clamp-2">
						{ *ur.Repository.Description }
					</p>
				}
			</div>
			<div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 flex items-center gap-3 text-xs text-gray-400 dark:text-gray-500">
				if ur.Repository.IsPrivate {
					<span class="flex items-center gap-1">
						<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"></path>
						</svg>
						Private
					</span>
				} else {
					<span class="flex items-center gap-1">
						<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"></path>
						</svg>
						Public
					</span>
				}
				if ur.Repository.IsFork {
					<span class="flex items-center gap-1">
						<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"></path>
						</svg>
						Fork
					</span>
				}
				if ur.Repository.DefaultBranch != "" {
					<span>{ ur.Repository.DefaultBranch }</span>
				}
			</div>
		</a>
	}
}

templ RepoCloneStatusBadge(status string) {
	switch status {
		case "ready":
			@templates.Badge("Ready", "green")
		case "cloning":
			<span
				class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-400 ring-1 ring-inset ring-blue-600/20"
			>
				<svg class="h-3 w-3 animate-spin" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
				</svg>
				Cloning
			</span>
		case "pending":
			@templates.Badge("Pending", "yellow")
		case "error":
			@templates.Badge("Error", "red")
		default:
			@templates.Badge(status, "")
	}
}
